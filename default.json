{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "baseBranches": [
        "dev"
    ],
    "dependencyDashboard": true,
    "labels": [
        "dependencies"
    ],
    "branchPrefix": "deps/",
    "extends": [
        "config:base"
    ],
    "timezone": "Europe/Berlin",
    "schedule": [
        "before 6am on monday"
    ],
    "reviewers": [
        "RainbowDashLabs"
    ],
    "prConcurrentLimit": 3,
    "prHourlyLimit": 10,
    "packageRules": [
        {
            "description": "npm packages wait 14 days after release",
            "matchManagers": [
                "npm"
            ],
            "minimumReleaseAge": "14 days"
        },
        {
            "description": "Auto-merge minor and patch updates",
            "matchUpdateTypes": [
                "minor",
                "patch",
                "pin",
                "digest"
            ],
            "automerge": true,
            "automergeType": "branch"
        },
        {
            "description": "Major updates require a PR and manual approval",
            "matchUpdateTypes": [
                "major"
            ],
            "automerge": false
        },
        {
            "description": "Group all non-major dependency updates",
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "all non-major dependencies",
            "groupSlug": "all-minor-patch"
        },
        {
            "description": "Group all major updates",
            "matchUpdateTypes": [
                "major"
            ],
            "groupName": "major updates",
            "groupSlug": "major"
        }
    ]
}

{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "baseBranches": [
        "dev"
    ],
    "dependencyDashboard": true,
    "labels": [
        "dependencies"
    ],
    "branchPrefix": "deps/",
    "extends": [
        "config:base"
    ],
    "reviewers": [
        "RainbowDashLabs"
    ],
    "prConcurrentLimit": 3,
    "prHourlyLimit": 10,
    "packageRules": [
        {
            "matchManagers": [
                "npm"
            ],
            "stabilityDays": 14,
            "schedule": [
                "on friday"
            ]
        },
        {
            "matchManagers": [
                "pip_requirements",
                "pip_setup",
                "pipenv",
                "poetry",
                "pip-compile",
                "pyenv"
            ],
            "schedule": [
                "on thursday"
            ]
        },
        {
            "description": "Auto-merge minor and patch updates",
            "matchUpdateTypes": [
                "minor",
                "patch",
                "pin",
                "digest"
            ],
            "automerge": true,
            "automergeType": "branch"
        },
        {
            "description": "Major updates require a PR and manual approval",
            "matchUpdateTypes": [
                "major"
            ],
            "automerge": false
        },
        {
            "description": "Group all non-major dependency updates",
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "all non-major dependencies",
            "groupSlug": "all-minor-patch"
        },
        {
            "description": "Group all major updates",
            "matchUpdateTypes": [
                "major"
            ],
            "groupName": "major updates",
            "groupSlug": "major"
        }
    ]
}
